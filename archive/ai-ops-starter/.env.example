# AI-OPS-STARTER — copy to .env on Brainiac 7 (Windows 11 Pro AI brain)
# cp .env.example .env   (Mac/Linux)  |  Copy-Item .env.example .env  (Windows)

# --- Brainiac hierarchy (7 = supreme owner; 6→1 = locations/operators) ---
BRAINIAC_TIER=7
BRAINIAC_NODE_ID=brainiac-7
BRAINIAC_LOCATION_CODE=home
BRAINIAC_OPERATOR_ID=brainiac-7
BRAINIAC_UPSTREAM_HOST=
BRAINIAC_UPSTREAM_TIER=
BRAINIAC_CAN_ESCALATE_TO=human
# Lower tiers: set BRAINIAC_UPSTREAM_HOST=brainiac-7 — see setup/tiers/

# --- Host identity (Brainiac 7 = primary intellect node) ---
AI_OPS_HOST_NAME=brainiac-7
AI_OPS_HOST_ROLE=supreme-brain
AI_OPS_PROJECT_ROOT=C:\AI-OPS-STARTER
NAS_MOUNT_PATH=W:\
NAS_AI_OPS_PATH=\\UGREEN-NAS\AI-OPS
NAS_CAPACITY_TB=60
NAS_HOT_PATH=W:\hot
NAS_LIFE_PATH=W:\life
NAS_WORK_PATH=W:\work
TZ=America/New_York

# --- Local ports (localhost only) ---
OPEN_WEBUI_PORT=3000
N8N_PORT=5678
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
POSTGRES_PORT=5432
REDIS_PORT=6379
WHISPER_PORT=8000
WHISPER_MODEL=base
ENABLE_VOICE_PROFILE=true

# --- Open WebUI ---
WEBUI_AUTH=true
ENABLE_SIGNUP=false
WEBUI_NAME=Brainiac 7
RAG_EMBEDDING_MODEL=nomic-embed-text

# Paid cloud APIs — DISABLED by default (local-first)
ENABLE_OPENAI_API=false
ENABLE_ANTHROPIC_API=false
ENABLE_GOOGLE_API=false

# --- n8n ---
N8N_HOST=localhost
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- PostgreSQL (n8n) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=n8n

# --- Redis (optional profile) ---
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Ollama (runs on host, not in compose) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b
OLLAMA_FAST_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Tailscale ---
# Install Tailscale on Windows/Mac; MagicDNS hostname for Brainiac 7
TAILSCALE_WINDOWS_HOST=brainiac-7
TAILSCALE_MAC_HOST=macbook-admin

# --- Escalation (human) ---
ESCALATION_NAME=Muhammad Taha
ESCALATION_EMAIL=
ESCALATION_SLACK_WEBHOOK=

# --- Mobile / phone (Tailscale → Brainiac 7) ---
MOBILE_WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
MOBILE_VERIFY_MODE=approve
# approve | auto_low_risk | auto (auto not recommended)
AUTO_REPLY_ENABLED=false
AUTO_REPLY_ALLOWED_CONTACTS=family,team-internal
AUTO_REPLY_NEVER=legal,contracts,angry-clients,new-leads,vip
BRAINIAC_N8N_WEBHOOK_BASE=http://127.0.0.1:5678/webhook
# From phone via Tailscale: http://brainiac-7:5678/webhook/...

# --- Optional paid escalation (COMMENTED — enable only if you accept cost/risk) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ENABLE_PAID_ESCALATION=false
# PAID_ESCALATION_MAX_TOKENS=2000
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
