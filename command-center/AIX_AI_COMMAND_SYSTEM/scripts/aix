#!/usr/bin/env bash
# Wrapper: load .env and run aix_operator.py
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if [[ -f "$ROOT/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$ROOT/.env"
  set +a
fi

if [[ -d "$ROOT/.venv/bin" ]]; then
  exec "$ROOT/.venv/bin/python" "$ROOT/aix_operator.py" "$@"
fi

exec python3 "$ROOT/aix_operator.py" "$@"
