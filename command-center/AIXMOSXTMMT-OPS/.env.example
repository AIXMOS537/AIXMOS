# Copy to .env on your USB — never commit .env

# === Supabase ===
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Clock app (Vite — same values as above)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# === Integrations ===
CLICKUP_API_TOKEN=
GHL_API_KEY=
GHL_LOCATION_ID=

# === People ===
CEO_EMAIL=
OPERATOR_1_EMAIL=
OPERATOR_2_EMAIL=
OPERATOR_3_EMAIL=

# === Locale ===
GENERIC_TIMEZONE=America/Chicago
PRIMARY_INBOX=google
PRIMARY_CALENDAR=google

# === Ollama (local laptop or Tailscale prime) ===
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_BASE_URL=http://prime:11434

# === NAS (when mounted) ===
NAS_AI_PATH_MAC=/Volumes/nas/ai
NAS_AI_PATH_WIN=Z:\\ai

# === Security ===
APPROVE_WEBHOOK_SECRET=change-me-to-random-string

# === Docker / n8n (set by scripts — optional override) ===
# ROOT=/Volumes/USB/AIXMOSXTMMT-OPS
