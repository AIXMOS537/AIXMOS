#!/usr/bin/env bash
# AIX Business Ops — one terminal driver for TMMT / rentals / leads / cleanup.
# Usage: aix-biz [morning|sync|leads|collections|cleanup|status|watch]
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TMMT_ROOT="$ROOT/TMMT MANAGEMENT"
AUTOMATIONS="$TMMT_ROOT/AUTOMATIONS"
OPS="$TMMT_ROOT/OPERATIONS"
AIX_SYS="$ROOT/AIX_AI_COMMAND_SYSTEM"
AIX="$AIX_SYS/scripts/aix"
CHUMMO="$ROOT/ops/chummo-stack"

# shellcheck source=scripts/lib/aix-biz-env.sh
source "$ROOT/scripts/lib/aix-biz-env.sh"
aix_biz_load_env "$ROOT"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*"; }
err()  { printf '  \033[31m✗\033[0m %s\n' "$*"; }
hr()   { printf '\n%s\n\n' "────────────────────────────────────────"; }

usage() {
  cat <<'EOF'
AIX Business Ops — run your business from Terminal

  aix-biz              Same as: aix-biz morning
  aix-biz morning      Live brief + command center + collections + lead drafts
  aix-biz sync         Regenerate DAILY_BRIEF from Supabase only
  aix-biz leads [N]    Draft outreach templates (approve before send)
  aix-biz leads --ai N CHUMMO/Ollama personalized drafts
  aix-biz collections  Refresh TODAY_COLLECTIONS from latest brief
  aix-biz cleanup      Sync COMMAND_CENTER date/priorities + prune old drafts
  aix-biz status       Credentials + services health
  aix-biz watch        Re-sync every 30 min (Ctrl+C to stop)
  aix-biz channels     iMessage / GHL / WhatsApp status
  aix-biz send         Interactive approve-and-send queue
  aix-biz send-one F [--channel ghl|imessage|whatsapp] [--yes]
  aix-biz open-ghl     Open GHL Conversations inbox
  aix-biz say CHANNEL PHONE "message"   Quick one-off (CHANNEL=imessage|ghl|whatsapp)

Env loads from (in order):
  TMMT MANAGEMENT/AUTOMATIONS/.env
  TMMT MANAGEMENT/tmmt-os/.env.local
  AIX_AI_COMMAND_SYSTEM/.env
  .env (repo root)

Lead messages are DRAFTS only — never auto-sent.
EOF
}

cmd_status() {
  bold "AIX Business Ops — status"
  hr
  bold "Integrations"
  if [[ -x "$AIX" ]]; then
    "$AIX" integrate status 2>/dev/null | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for k, v in d.get('credentials', {}).items():
    print(f\"  {'✓' if v else '○'} {k}\")
print(f\"  Supabase tables: {len(d.get('supabase_tables', []))}\")
" 2>/dev/null || "$AIX" integrate status
  else
    warn "aix CLI not found at $AIX"
  fi
  hr
  bold "Services"
  if curl -sf -o /dev/null --max-time 2 http://127.0.0.1:3000 2>/dev/null; then
    ok "TMMT dev server :3000"
  else
    warn "TMMT dev server :3000 not responding"
  fi
  if curl -sf -o /dev/null --max-time 2 "${OLLAMA_BASE_URL:-http://127.0.0.1:11434}/api/tags" 2>/dev/null; then
    ok "Ollama"
  else
    warn "Ollama not running (optional for lead drafts)"
  fi
  local latest
  latest=$(ls -t "$OPS"/DAILY_BRIEF_*.md 2>/dev/null | head -1 || true)
  if [[ -n "$latest" ]]; then
    ok "Latest brief: $(basename "$latest")"
  else
    warn "No DAILY_BRIEF yet — run: aix-biz sync"
  fi
}

cmd_sync() {
  bold "Syncing live data from Supabase…"
  python3 "$AUTOMATIONS/SCRIPTS/daily_command_center.py"
  python3 "$AUTOMATIONS/SCRIPTS/sync_command_center_from_brief.py"
  python3 "$AUTOMATIONS/SCRIPTS/refresh_collections_queue.py"
  hr
  ok "Done. Open: $OPS/COMMAND_CENTER.md"
}

cmd_leads() {
  local limit="10"
  local mode="template"
  if [[ "${1:-}" == "--ai" ]]; then
    mode="ai"
    limit="${2:-10}"
  elif [[ -n "${1:-}" && "${1:-}" =~ ^[0-9]+$ ]]; then
    limit="$1"
  fi
  bold "Drafting lead messages (approve before send)…"
  if [[ "$mode" == "ai" ]]; then
    if [[ ! -d "$CHUMMO/node_modules" ]]; then
      (cd "$CHUMMO" && npm install --silent)
    fi
    node "$CHUMMO/chummo-draft-leads.js" --limit "$limit" \
      --status "New Lead,Qualified,waiting,form sent,no resp" \
      || python3 "$AUTOMATIONS/SCRIPTS/draft_leads_simple.py" --limit "$limit"
  else
    ok "Template drafts (add --ai for CHUMMO/Ollama personalized drafts)"
    python3 "$AUTOMATIONS/SCRIPTS/draft_leads_simple.py" --limit "$limit"
  fi
  hr
  local day
  day=$(date +%Y-%m-%d)
  ok "Drafts: $OPS/VA_LEAD_DRAFTS/$day/INDEX.md"
}

cmd_collections() {
  python3 "$AUTOMATIONS/SCRIPTS/refresh_collections_queue.py"
  hr
  bold "Top of queue"
  head -25 "$OPS/TODAY_COLLECTIONS.md"
}

cmd_cleanup() {
  bold "Cleanup — command center + stale drafts"
  if ls "$OPS"/DAILY_BRIEF_*.md &>/dev/null; then
    python3 "$AUTOMATIONS/SCRIPTS/sync_command_center_from_brief.py"
    python3 "$AUTOMATIONS/SCRIPTS/refresh_collections_queue.py"
  else
    warn "No brief yet — running full sync first"
    cmd_sync
  fi
  local drafts="$OPS/VA_LEAD_DRAFTS"
  if [[ -d "$drafts" ]]; then
    find "$drafts" -mindepth 1 -maxdepth 1 -type d -mtime +14 -print 2>/dev/null | while read -r d; do
      warn "Old draft folder (>14d): $(basename "$d") — archive manually if done"
    done
  fi
  hr
  bold "Stale COMMAND_CENTER tasks (due in the past)"
  OPS_PATH="$OPS" python3 - <<'PY'
import re
from datetime import date, datetime
from pathlib import Path
import os
cc = Path(os.environ["OPS_PATH"]) / "COMMAND_CENTER.md"
if not cc.exists():
    raise SystemExit(0)
text = cc.read_text()
today = date.today()
for line in text.splitlines():
    if "|" not in line or "Due Date" in line or "---" in line:
        continue
    cells = [c.strip() for c in line.strip("|").split("|")]
    if len(cells) < 5:
        continue
    due = cells[3]
    for fmt in ("%b %d", "%B %d", "%Y-%m-%d"):
        try:
            d = datetime.strptime(due.replace(",", ""), fmt).replace(year=today.year).date()
            if d < today:
                print(f"  ! {cells[0][:40]} — due {due}")
            break
        except ValueError:
            continue
PY
  ok "Cleanup pass complete"
}

cmd_morning() {
  bold "AIX Business Ops — Morning $(date '+%A %B %-d %Y')"
  hr
  cmd_sync
  hr
  cmd_leads 8
  hr
  bold "5. Send queue (optional)"
  ok "Run: aix-biz send   — approve each draft → GHL / iMessage / WhatsApp"
  ok "Run: aix-biz open-ghl — GHL inbox (WhatsApp + SMS for rentals)"
  hr
  bold "Your next 3 actions"
  OPS_PATH="$OPS" python3 - <<'PY'
from pathlib import Path
import os
ops = Path(os.environ["OPS_PATH"])
cc = ops / "COMMAND_CENTER.md"
if cc.exists():
    text = cc.read_text()
    in_top = False
    n = 0
    for line in text.splitlines():
        if "### Top 3 Priorities" in line:
            in_top = True
            continue
        if in_top and line.startswith("###"):
            break
        if in_top and line.strip().startswith(tuple("123")):
            print(f"  {line.strip()}")
            n += 1
            if n >= 3:
                break
coll = ops / "TODAY_COLLECTIONS.md"
if coll.exists():
    for line in coll.read_text().splitlines():
        if line.startswith("| 1 |"):
            print(f"\n  💰 First collection: {line}")
            break
PY
  hr
  bold "Open in Cursor"
  ok "$OPS/COMMAND_CENTER.md"
  ok "$OPS/TODAY_COLLECTIONS.md"
  local brief
  brief=$(ls -t "$OPS"/DAILY_BRIEF_*.md 2>/dev/null | head -1 || true)
  [[ -n "$brief" ]] && ok "$(basename "$brief")"
  echo ""
  echo "  TMMT dashboard: ${VERCEL_APP_URL:-https://tmmt-c919-two.vercel.app}/internal/dashboard"
  echo "  Lead drafts need YOUR approval before any send."
}

OUTBOUND="$AUTOMATIONS/SCRIPTS/outbound_send.py"

cmd_channels() {
  python3 "$OUTBOUND" channels
}

cmd_send() {
  bold "Outbound queue — approve each message before send"
  ok "GHL = SMS/WhatsApp through GoHighLevel (preferred for customers)"
  ok "iMessage = Mac Messages.app"
  ok "WhatsApp = opens wa.me (personal); rentals should use GHL"
  hr
  python3 "$OUTBOUND" queue --limit "${1:-15}"
}

cmd_send_one() {
  local file="" channel="auto" yes_flag=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --channel) channel="$2"; shift 2 ;;
      --yes) yes_flag="--yes"; shift ;;
      *) file="$1"; shift ;;
    esac
  done
  if [[ -z "$file" ]]; then
    err "Usage: aix-biz send-one path/to/draft.md [--channel ghl|imessage|whatsapp] [--yes]"
    exit 1
  fi
  # shellcheck disable=SC2086
  python3 "$OUTBOUND" send --file "$file" --channel "$channel" $yes_flag
}

cmd_open_ghl() {
  python3 - <<PY
import os, subprocess
from pathlib import Path
for p in [Path("$TMMT_ROOT/tmmt-os/.env.local"), Path("$AUTOMATIONS/.env")]:
    if p.exists():
        for line in p.read_text().splitlines():
            if "=" in line and not line.strip().startswith("#"):
                k, _, v = line.partition("=")
                os.environ.setdefault(k.strip(), v.strip().strip('"').strip("'"))
loc = os.environ.get("GHL_LOCATION_ID", "")
if not loc:
    raise SystemExit("GHL_LOCATION_ID not set")
subprocess.run(["open", f"https://app.gohighlevel.com/v2/location/{loc}/conversations/conversations"], check=False)
print("Opened GHL Conversations")
PY
}

cmd_say() {
  local ch="${1:-}"
  local phone="${2:-}"
  local msg="${3:-}"
  if [[ -z "$ch" || -z "$phone" || -z "$msg" ]]; then
    err 'Usage: aix-biz say imessage|ghl|whatsapp "+15551234567" "Your message"'
    exit 1
  fi
  local tmp
  tmp="$(mktemp /tmp/aix-biz-draft.XXXXXX.md)"
  cat >"$tmp" <<EOF
# Quick send

| Phone | $phone |
| Email | — |

## Draft

\`\`\`
$msg
\`\`\`
EOF
  python3 "$OUTBOUND" send --file "$tmp" --channel "$ch" ${4:-}
  rm -f "$tmp"
}

cmd_watch() {
  local interval="${1:-1800}"
  bold "Watch mode — re-sync every ${interval}s (Ctrl+C to stop)"
  while true; do
    cmd_sync
    sleep "$interval"
  done
}

main() {
  local cmd="${1:-morning}"
  shift || true
  case "$cmd" in
    -h|--help|help) usage ;;
    morning|"") cmd_morning ;;
    sync) cmd_sync ;;
    leads) cmd_leads "${1:-10}" ;;
    collections) cmd_collections ;;
    cleanup) cmd_cleanup ;;
    status) cmd_status ;;
    watch) cmd_watch "${1:-1800}" ;;
    channels) cmd_channels ;;
    send) cmd_send "${1:-15}" ;;
    send-one) shift; cmd_send_one "$@" ;;
    open-ghl|ghl) cmd_open_ghl ;;
    say) shift; cmd_say "$@" ;;
    *)
      err "Unknown command: $cmd"
      usage
      exit 1
      ;;
  esac
}

main "$@"
