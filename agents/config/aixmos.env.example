# Copy to D:\AIXMOS-AGENTS\.env or D:\AIXMOS-AGENTS\config\aixmos.env
# Values can also be loaded from tmmt-os\.env.local automatically.

# Claude agents (CHUMMO, MOOSE, JARVIS, panel votes)
ANTHROPIC_API_KEY=

# TMMT OS production API
TMMT_OPS_URL=https://your-tmmt-os.vercel.app
AGENT_WEBHOOK_SECRET=

# Supabase (STICKS overdue scan)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# GHL overdue webhook (STICKS --push-ghl)
GHL_OVERDUE_WEBHOOK_SECRET=
# or GHL_WEBHOOK_SECRET=

# Optional — Claude model id. Current default is Opus 5.
AIXMOS_MODEL=claude-opus-5

# ── LLM backend selector ──────────────────────────────────
#   claude  (default) — Anthropic cloud API, requires ANTHROPIC_API_KEY + internet
#   ollama            — local Ollama runtime, fully offline once model is pulled
#   auto              — try Claude first, fall back to Ollama if cloud unreachable
AIXMOS_LLM_BACKEND=claude

# Local LLM (Ollama) — only used when backend is ollama or auto fallback fires.
#
# ⚠️ VERIFY THE TAG EXISTS ON THIS MACHINE FIRST:  ollama list
#    A tag that is not installed does not error loudly — the lane just returns
#    nothing and looks configured. Never copy a model name across machines.
#
# Known-installed as of 2026-09-19:
#   BRAINIAC : qwen3:14b · gpt-oss:20b · devstral:24b · deepseek-r1:14b · gemma4:26b
#              qwen2.5vl:7b (vision) · tmmt-ops · tmmt-brain · rick · cyborg
#   M1       : qwen2.5:14b · qwen2.5-coder:14b · llama3.2:3b · aixmos · moondream (vision)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
# Lighter lane (M1 / USB-portable):
# OLLAMA_MODEL=llama3.2:3b
