# Copy to D:\AIXMOS-AGENTS\.env or D:\AIXMOS-AGENTS\config\aixmos.env
# Values can also be loaded from tmmt-os\.env.local automatically.

# Claude agents (CHUMMO, MOOSE, JARVIS, panel votes)
ANTHROPIC_API_KEY=

# TMMT OS production API
TMMT_OPS_URL=https://your-tmmt-os.vercel.app
AGENT_WEBHOOK_SECRET=

# Supabase (STICKS overdue scan)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# GHL overdue webhook (STICKS --push-ghl)
GHL_OVERDUE_WEBHOOK_SECRET=
# or GHL_WEBHOOK_SECRET=

# Optional — Claude model id
AIXMOS_MODEL=claude-sonnet-4-6

# ── LLM backend selector ──────────────────────────────────
#   claude  (default) — Anthropic cloud API, requires ANTHROPIC_API_KEY + internet
#   ollama            — local Ollama runtime, fully offline once model is pulled
#   auto              — try Claude first, fall back to Ollama if cloud unreachable
AIXMOS_LLM_BACKEND=claude

# Local LLM (Ollama) — only used when backend is ollama or auto fallback fires
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Smaller model for laptops / USB-portable mode (~2.3 GB on disk):
# OLLAMA_MODEL=phi3:mini
