#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════════
# AIXMOS — the one launcher.
#
# This folder grew 25 entry points (START-HERE, RUN-FROM-USB, AI-BRAIN,
# LOAD-ME-FIRST, OFFLINE-MODE-SETUP, MAKE-DESKTOP-BRAIN …). Someone opening it
# had no idea which one to click. This is the single door: it works out what is
# already true on this machine, tells you honestly, and only then offers choices.
#
# It never reports something as ready that it has not actually checked.
#
#   bash bin/aixmos            interactive
#   bash bin/aixmos doctor     preflight only, exits non-zero if not runnable
#   bash bin/aixmos <agent>    run one agent directly
# ═══════════════════════════════════════════════════════════════════════════════
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$HERE"

B=$'\033[1m'; D=$'\033[2m'; R=$'\033[0m'
GRN=$'\033[0;32m'; RED=$'\033[0;31m'; YEL=$'\033[1;33m'; CYN=$'\033[0;36m'
ok(){ printf "  ${GRN}✓${R} %s\n" "$1"; }
no(){ printf "  ${RED}✗${R} %s\n" "$1"; }
warn(){ printf "  ${YEL}!${R} %s\n" "$1"; }
info(){ printf "  ${D}%s${R}\n" "$1"; }

AGENTS="chummo moose captain wonderwoman vision jarvis tank flyguy bob sticks"

banner() {
  printf "\n  ${B}AIXMOS${R} ${D}— agent network${R}\n"
  printf "  ${D}For the people. By the people.${R}\n\n"
}

# ── PREFLIGHT ─────────────────────────────────────────────────────────────────
# Every line below is a real check. Nothing is assumed.
READY=1
preflight() {
  printf "  ${B}Checking this machine${R}\n"

  if command -v node >/dev/null 2>&1; then
    local v; v="$(node -v 2>/dev/null)"
    local maj; maj="$(printf '%s' "$v" | sed -E 's/^v([0-9]+).*/\1/')"
    if [ "${maj:-0}" -ge 18 ] 2>/dev/null; then ok "node $v"
    else no "node $v — needs 18 or newer"; READY=0; fi
  else
    no "node not installed — https://nodejs.org (or use _installers/ on Windows)"
    READY=0
  fi

  # Thinking backend. Either is fine; neither is not.
  local backend="${AIXMOS_LLM_BACKEND:-}"
  [ -z "$backend" ] && [ -f config/aixmos.env ] && backend="$(grep -E '^AIXMOS_LLM_BACKEND=' config/aixmos.env 2>/dev/null | cut -d= -f2 | tr -d '\r')"
  backend="${backend:-auto}"

  local ollama=0 claude=0
  curl -fsS --max-time 2 "${OLLAMA_HOST:-http://localhost:11434}/api/tags" >/dev/null 2>&1 && ollama=1
  { [ -n "${ANTHROPIC_API_KEY:-}" ] || grep -qE '^ANTHROPIC_API_KEY=.+' config/aixmos.env 2>/dev/null; } && claude=1

  [ "$ollama" = 1 ] && ok "Ollama reachable — offline mode available" || info "Ollama not running (offline mode unavailable)"
  [ "$claude" = 1 ] && ok "Anthropic key present" || info "no Anthropic key (cloud mode unavailable)"

  if [ "$ollama" = 0 ] && [ "$claude" = 0 ]; then
    no "no thinking backend — install Ollama, or set ANTHROPIC_API_KEY"
    READY=0
  else
    ok "backend: $backend"
  fi

  # ── SAFETY. Reported every launch, because it governs what leaves this machine.
  printf "\n  ${B}Safety${R}\n"
  local cfg="imessage-relay/config.json"
  if [ -f "$cfg" ]; then
    if grep -q '"allow_send"[[:space:]]*:[[:space:]]*true' "$cfg" 2>/dev/null; then
      warn "iMessage sending is ON — this machine can message people"
    else
      ok "iMessage sending is OFF (allow_send: false)"
    fi
  else
    ok "iMessage relay not configured — nothing can send"
  fi

  # The do-not-contact gate fails closed, so an unreadable list blocks every send.
  # Say so here rather than letting someone discover it mid-campaign.
  local dnc; dnc="$(node -e "
    try { const s=require('./lib/suppression'); const fs=require('fs');
      if(!fs.existsSync(s.listPath)) { console.log('empty'); process.exit(0); }
      s.isSuppressed('5555555555'); console.log('ok');
    } catch(e) { console.log('broken'); }" 2>/dev/null)"
  case "$dnc" in
    ok)     ok "do-not-contact list readable" ;;
    empty)  ok "do-not-contact list empty (nobody has opted out yet)" ;;
    *)      no "do-not-contact list UNREADABLE — every send will be refused until fixed"; READY=0 ;;
  esac
}

menu() {
  printf "\n  ${B}What do you want to do?${R}\n\n"
  printf "   ${CYN}1${R}  Talk to an agent\n"
  printf "   ${CYN}2${R}  Install / update on this machine  ${D}(mirrors to ~/AIXMOS)${R}\n"
  printf "   ${CYN}3${R}  Set up offline mode               ${D}(Ollama, no API key)${R}\n"
  printf "   ${CYN}4${R}  Run the safety tests\n"
  printf "   ${CYN}5${R}  Manage do-not-contact list\n"
  printf "   ${CYN}q${R}  Quit\n\n"
  printf "  > "; read -r choice
  case "${choice:-q}" in
    1) pick_agent ;;
    2) if [ "$(uname -s)" = "Darwin" ]; then bash install-mac.sh; else info "Windows: run install-windows.bat"; fi ;;
    3) if [ -f OFFLINE-MODE-SETUP.command ]; then bash OFFLINE-MODE-SETUP.command; else info "Install Ollama from https://ollama.com then: ollama pull llama3.1:8b"; fi ;;
    4) npm test ;;
    5) node -e "const s=require('./lib/suppression');console.log('list:',s.listPath)"; info "add:    node -e \"console.log(require('./lib/suppression').suppress('555-123-4567','manual'))\""; info "remove: node -e \"console.log(require('./lib/suppression').unsuppress('555-123-4567'))\"" ;;
    q|Q) exit 0 ;;
    *) info "not a choice" ;;
  esac
}

pick_agent() {
  printf "\n  ${B}Agents${R}\n"
  local i=1
  for a in $AGENTS; do printf "   ${CYN}%2d${R}  %s\n" "$i" "$a"; i=$((i+1)); done
  printf "\n  > "; read -r n
  local sel; sel="$(printf '%s\n' $AGENTS | sed -n "${n}p" 2>/dev/null)"
  if [ -z "$sel" ]; then info "not a choice"; return; fi
  run_agent "$sel"
}

run_agent() {
  local a="$1"; shift || true
  if [ ! -f "$a.js" ]; then no "no such agent: $a"; info "available: $AGENTS"; return 1; fi
  printf "\n  ${D}→ $a${R}\n\n"
  node "$a.js" "$@"
}

# ── ENTRY ─────────────────────────────────────────────────────────────────────
case "${1:-}" in
  doctor)
    banner; preflight
    if [ "$READY" = 1 ]; then printf "\n  ${GRN}Ready.${R}\n\n"; exit 0
    else printf "\n  ${RED}Not ready — fix the ✗ lines above.${R}\n\n"; exit 1; fi
    ;;
  "" )
    banner; preflight
    [ "$READY" = 1 ] || printf "\n  ${YEL}Some things are missing. You can still use the menu to fix them.${R}\n"
    while true; do menu; done
    ;;
  -h|--help|help)
    banner
    printf "  bash bin/aixmos            interactive\n"
    printf "  bash bin/aixmos doctor     preflight only\n"
    printf "  bash bin/aixmos <agent>    run one agent\n\n"
    printf "  agents: $AGENTS\n\n"
    ;;
  *)
    run_agent "$@"
    ;;
esac
